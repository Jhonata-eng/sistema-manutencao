APP_NAME="Controle de Manutenções"
# Produção: APP_ENV=production e APP_DEBUG=false (com debug ligado, erros mostram código e configuração)
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8090
APP_TIMEZONE=America/Sao_Paulo

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=manutencao
DB_USERNAME=manutencao
DB_PASSWORD=manutencao

# Expiração da sessão por inatividade, em minutos ("lembrar-me" mantém o login além disso)
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_EXPIRE_ON_CLOSE=false
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# true em produção (cookie de sessão só trafega por HTTPS)
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# E-mail é opcional; o sistema não depende de SMTP
MAIL_MAILER=log
MAIL_FROM_ADDRESS="nao-responda@exemplo.com.br"
MAIL_FROM_NAME="${APP_NAME}"

# Regras do sistema (config/manutencao.php)
MANUTENCAO_HORIZONTE_MESES=12
ANEXO_TAMANHO_MAX_MB=10
LOGIN_MAX_TENTATIVAS=5

# Somente desenvolvimento com Docker Compose
APP_PORT=8090
FORWARD_DB_PORT=3307
DB_ROOT_PASSWORD=root
